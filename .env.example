# Copy to .env for local development (never commit the real .env).

# Notion internal integration token (share the databases with this integration).
NOTION_TOKEN=secret_xxx

# Shared secret the client sends in the X-API-Key header.
API_SECRET=change-me

# Notion Databases
TRANSACTIONS_DS_ID=abcdefgh-ijkl-mnop-qrst-uvwxyzabcdef
ACCOUNTS_DS_ID=abcdefgh-ijkl-mnop-qrst-uvwxyzabcdef
CATEGORIES_DS_ID=abcdefgh-ijkl-mnop-qrst-uvwxyzabcdef
MONTHS_DS_ID=abcdefgh-ijkl-mnop-qrst-uvwxyzabcdef

# Savings interest accrual (all optional; the defaults below are used if unset).
# Override only to rename the Accounts properties or tune the payout labels.
SAVINGS_EARNS_INTEREST_PROPERTY=Earns Interest
SAVINGS_AER_PROPERTY=AER
SAVINGS_PAYMENT_DAY_PROPERTY=Interest Payment Day
SAVINGS_BALANCE_PROPERTY=Current Balance
SAVINGS_ACCRUED_PROPERTY=Accrued Interest
SAVINGS_LAST_ACCRUED_PROPERTY=Last Accrued
SAVINGS_LAST_PAID_PROPERTY=Last Interest Paid
# Title and category of the monthly interest transaction.
SAVINGS_INTEREST_NAME=Interest
SAVINGS_INTEREST_CATEGORY=Interest
